{
  "expo": {
    "name": "C1",
    "slug": "c1-nutrition",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "c1app",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayhamabdullah.c1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan your meals to track nutrition automatically.",
        "NSPhotoLibraryUsageDescription": "Pick meal photos from your gallery to log calories.",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ayhamabdullah.c1",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your meals to track nutrition automatically."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick meal photos from your gallery to log calories."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0C"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3656632924764645~6219258098",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "admob": {
        "androidAppId": "ca-app-pub-3656632924764645~6219258098",
        "iosAppId": "PENDING_USER_TO_CREATE_IOS_ADMOB_APP",
        "rewardedUnitId": "ca-app-pub-3656632924764645/2694232041",
        "interstitialUnitId": "ca-app-pub-365663292476645/7939533877",
        "iosRewardedTestUnitId": "ca-app-pub-3940256099942544/1712485313",
        "iosInterstitialTestUnitId": "ca-app-pub-3940256099942544/4411468910"
      }
    }
  }
}
